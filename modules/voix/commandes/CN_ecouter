#!/usr/bin/env python3
"""Transcrit un fichier audio (webm/ogg/wav). Usage : ecouter CHEMIN [langue=fr] [modele=small] [lexique].
Le modèle est l'un de tiny, base, small, medium (tout autre nom retombe sur small) ; le lexique (noms propres, mots de la maison) oriente la transcription.
Le fichier est lu puis il revient au noyau de l'effacer : une voix est une donnée personnelle."""
import sys

MODELES = ("tiny", "base", "small", "medium")


def main():
    if len(sys.argv) < 2:
        sys.exit(2)
    chemin = sys.argv[1]
    langue = sys.argv[2] if len(sys.argv) > 2 else "fr"
    modele = sys.argv[3] if len(sys.argv) > 3 and sys.argv[3] in MODELES else "small"
    lexique = sys.argv[4].strip() if len(sys.argv) > 4 else ""
    try:
        from faster_whisper import WhisperModel
    except Exception:
        print("erreur : faster-whisper n'est pas installé (pip install faster-whisper)")
        sys.exit(3)
    try:
        m = WhisperModel(modele, device="cpu", compute_type="int8")
        segments, _ = m.transcribe(chemin, language=langue, vad_filter=True, condition_on_previous_text=False,
                                   initial_prompt=("Mots employés : " + lexique) if lexique else None)
        texte = " ".join((s.text or "").strip() for s in segments).strip()
    except Exception as e:
        print("erreur : %s" % e)
        sys.exit(4)
    print(texte)


if __name__ == "__main__":
    main()
