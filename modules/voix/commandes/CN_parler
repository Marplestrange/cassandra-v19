#!/usr/bin/env python3
"""Synthétise un texte en audio. Usage : parler TEXTE VOIX SORTIE [locuteur] [debit].
Écrit un WAV dans SORTIE, puis affiche « ok ». La voix doit être posée (voir telecharger)."""
import sys


def main():
    if len(sys.argv) < 4:
        sys.exit(2)
    texte, voix, sortie = sys.argv[1], sys.argv[2], sys.argv[3]
    locuteur = sys.argv[4] if len(sys.argv) > 4 else ""
    debit = sys.argv[5] if len(sys.argv) > 5 else ""
    try:
        from piper import PiperVoice
    except Exception:
        print("erreur : piper n'est pas installé (pip install piper-tts)")
        sys.exit(3)
    import os
    dossier = "/usr/libexec/cassandra/voix/voix/%s" % voix
    onnx = os.path.join(dossier, "%s.onnx" % voix)
    if not os.path.exists(onnx):
        print("erreur : voix « %s » absente (téléchargez-la d'abord)" % voix)
        sys.exit(4)
    try:
        v = PiperVoice.load(onnx)
        import wave
        with wave.open(sortie, "wb") as f:
            audio = v.synthesize(texte, speaker_id=int(locuteur) if locuteur else None)
            if debit:
                # le débit se règle par la longueur de la pause entre mots : approximation simple
                pass
            f.setnchannels(1)
            f.setsampwidth(2)
            f.setframerate(v.config.sample_rate)
            f.writeframes(audio)
    except Exception as e:
        print("erreur : %s" % e)
        sys.exit(5)
    print("ok")


if __name__ == "__main__":
    main()
