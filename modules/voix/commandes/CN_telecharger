#!/usr/bin/env python3
"""Télécharge une voix piper depuis HuggingFace. Usage : telecharger VOIX_ID.
La voix est posée dans /usr/libexec/cassandra/voix/voix/<id>/."""
import os
import subprocess
import sys

HF = "https://huggingface.co/rhasspy/piper-voices/resolve/main/fr/fr_FR"


def main():
    if len(sys.argv) < 2:
        sys.exit(2)
    vid = sys.argv[1]
    if not vid.startswith("fr_FR-") or "/" in vid or ".." in vid:
        print("erreur : identifiant de voix illisible")
        sys.exit(3)
    dossier = "/usr/libexec/cassandra/voix/voix/%s" % vid
    os.makedirs(dossier, exist_ok=True)
    base = "%s/%s/%s" % (HF, vid, vid)
    for ext in (".onnx", ".onnx.json"):
        cible = os.path.join(dossier, vid + ext)
        if os.path.exists(cible):
            continue
        r = subprocess.run(["wget", "-q", "-O", cible, base + ext], capture_output=True, text=True, timeout=600)
        if r.returncode != 0:
            print("erreur : téléchargement de %s refusé (huggingface joignable ?)" % ext)
            sys.exit(4)
    print("ok")


if __name__ == "__main__":
    main()
