#!/usr/bin/env python3
"""Installe et pilote un SERVEUR NetBird auto-hébergé À ROOT, par le courtier. Usage : serveur <verbe> [arguments]

Un serveur NetBird (gestion, signal, relais, tableau de bord) est la pile Docker que fournit NetBird lui-même, par son script `getting-started.sh`. Ce programme ne fait que la poser,
la tenir à jour et la retirer : l'ADMINISTRATION (machines, clés, groupes, politiques) passe par l'API du serveur, depuis le module, sans root.

Ce que ce programme garantit, parce qu'il tourne à root :
  - le dossier du serveur est GRAVÉ ici (/opt/netbird-serveur) : jamais un argument, jamais un lien symbolique ;
  - le script officiel est téléchargé À PART (verbe `telecharger`), son empreinte SHA-256 est rendue à la personne qui décide, et `installer` ne le lance que si l'empreinte qu'elle a
    confirmée est celle du fichier posé sur le disque (un fichier changé entre-temps n'est jamais exécuté) ; la version est EXPLICITE (v0.40.0), jamais « latest » ;
  - rien ne passe par un shell : chaque argument est vérifié par une expression bornée ; l'environnement du script est construit ici, pas reçu ;
  - un serveur déjà posé n'est jamais écrasé (le script officiel refuse aussi s'il trouve config.yaml).

Verbes (table fermée) :
  etat                                           ce qui est posé : Docker, jq, la pile, ses conteneurs, ce que Cassandra en sait (version, domaine)
  telecharger <version>                          pose le script officiel de cette version ; rend son empreinte SHA-256 et sa taille
  installer <version> <sha256> <domaine> <email> <traefik|nginx|caddy>
                                                 lance le script (sans question) ; rend ce qu'il a dit. traefik : TLS intégré, ports 80 et 443 libres exigés ;
                                                 nginx, caddy : le serveur n'écoute que sur 127.0.0.1, le proxy existant le publie (la conf générée se lit avec `nginx`)
  mettre_a_jour                                  docker compose pull, puis up -d
  commande up|down|restart|logs                  docker compose, rien d'autre
  nginx                                          lit la conf nginx que le script a générée (si le proxy est nginx)
  sauvegarder [raison]                           copie les volumes et le dossier du serveur dans /var/backups/cassandra/netbird/<date> (le serveur est arrêté le temps de la copie) ;
                                                 raison : manuelle, avant_maj, avant_retrait, avant_restauration ; les 10 plus récentes sont gardées
  sauvegardes                                    la liste des sauvegardes (date, raison, taille, version)
  restaurer <id> [images]                        remet une sauvegarde (une sauvegarde de sécurité est faite avant) ; « images » remet aussi les images d'alors
  pare_feu                                       ufw ou firewalld : actif ? et lesquels des ports NetBird sont ouverts
  pare_feu_ouvrir <traefik|nginx|caddy>          ouvre les ports publics de NetBird (443/tcp, 3478/udp, et 80/tcp avec traefik) ; rend ceux qu'elle a ouverts elle-même
  pare_feu_fermer <port/proto>…                  referme ces ports, parmi ceux de NetBird seulement
  installer_compose                              installe Docker Compose (docker-compose-plugin, docker-compose-v2 ou docker-compose : le premier que la distribution offre)
  installer_jq                                   installe jq (exigé par le script officiel) par apt-get, dnf ou yum, et rien d'autre
  ip                                             l'adresse de cette machine, telle que la voit le réseau (pour l'enregistrement DNS)
  retirer [purger]                               docker compose down ; avec « purger » : les volumes et le dossier (les comptes et les machines du serveur sont PERDUS)
Rend UNE ligne de JSON : {"ok": true, …} ou {"ok": false, "erreur": "…"} ; le code de sortie est 0 si ok."""
import errno
import hashlib
import json
import os
import re
import shutil
import ipaddress
import socket
import subprocess
import sys
import tarfile
import time
import urllib.request

DOSSIER = "/opt/netbird-serveur"
MARQUE = "cassandra.json"
SCRIPT = "getting-started.sh"
URL_SCRIPT = "https://github.com/netbirdio/netbird/releases/download/%s/getting-started.sh"
VERSION = re.compile(r"^v\d{1,3}\.\d{1,3}\.\d{1,3}$")
SHA = re.compile(r"^[0-9a-f]{64}$")
DOMAINE = re.compile(r"^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})$")
RESERVES = (".example", ".test", ".invalid", ".localhost", ".local", ".localdomain", ".example.com", ".example.org", ".example.net")      # RFC 2606 et 6761 : aucun certificat ne s'y obtient
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
EMAIL = re.compile(r"^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\.[A-Za-z]{2,24}$")
PROXYS = {"traefik": "0", "nginx": "2", "caddy": "4"}           # NETBIRD_REVERSE_PROXY_TYPE du script officiel
ACTIONS = {"up": ["up", "-d"], "down": ["down"], "restart": ["restart"], "logs": ["logs", "--tail", "80", "--no-color"]}
SCRIPT_MAX = 300000
SORTIE_MAX = 4000
SORTIE_LISTE = 400000                                              # `compose ps --format json` : une ligne par service, avec ses étiquettes ; la couper ferait perdre des services
DELAI_INSTALL = 280
DELAI_TIRER = 200                                              # le courtier coupe à 300 s : télécharger puis relancer doit tenir dans ce délai (200 + 90)
DELAI_RELANCER = 90
SAUVEGARDES = "/var/backups/cassandra/netbird"
ID_SAUV = re.compile(r"^\d{8}-\d{6}$")
RAISONS = ("manuelle", "avant_maj", "avant_retrait", "avant_restauration")
GARDER = 10                                                    # les sauvegardes les plus récentes qu'on garde ; les plus anciennes partent
REF_IMAGE = re.compile(r"^[a-z0-9][a-z0-9./_-]{0,120}(:[A-Za-z0-9_.-]{1,127})?$")
ID_IMAGE = re.compile(r"^sha256:[0-9a-f]{64}$")
PORTS_NETBIRD = ("80/tcp", "443/tcp", "3478/udp")                  # les seuls ports que le pare-feu ouvre ou referme d'ici
COMMENTAIRE_PF = "NetBird (Cassandra)"
PLUGINS_COMPOSE = ("/usr/libexec/docker/cli-plugins/docker-compose", "/usr/lib/docker/cli-plugins/docker-compose", "/usr/local/libexec/docker/cli-plugins/docker-compose", "/usr/local/lib/docker/cli-plugins/docker-compose")

executer = subprocess.run                                       # remplaçables : les bancs n'ont ni Docker, ni réseau, ni ports à eux
ouvrir = urllib.request.urlopen


def refuser(raison):
    raise ValueError(raison)


def verifier(valeur, motif, quoi):
    if not isinstance(valeur, str) or not motif.match(valeur):
        refuser("%s illisible" % quoi)
    return valeur


PORTS_SURVEILLES = (("tcp", 80), ("tcp", 443), ("tcp", 8080), ("tcp", 8081), ("udp", 3478))      # ceux que la pile NetBird utilise (docs.netbird.io/selfhosted/external-reverse-proxy)


def lier(famille, protocole, port):
    """True : l'adresse a pu être prise (le port est libre) ; False : il est utilisé ; None : cette famille d'adresses n'existe pas ici."""
    try:
        s = socket.socket(famille, socket.SOCK_STREAM if protocole == "tcp" else socket.SOCK_DGRAM)
    except OSError:
        return None
    try:
        if protocole == "tcp":
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)                  # un port en TIME_WAIT n'est pas « pris »
        if famille == socket.AF_INET6:
            s.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)                 # l'écoute IPv6 ne se confond pas avec l'IPv4
        s.bind(("0.0.0.0" if famille == socket.AF_INET else "::", port))
        return True
    except OSError as e:
        return False if e.errno in (errno.EADDRINUSE, errno.EACCES) else None
    finally:
        s.close()


def port_libre(protocole, port):
    """Le port est-il libre sur la machine, en IPv4 comme en IPv6 ? (on tente de l'occuper un instant)"""
    return all(lier(f, protocole, port) is not False for f in (socket.AF_INET, socket.AF_INET6))


def ports_requis(proxy):
    """Ce que la pile doit pouvoir prendre : 80 et 443 avec traefik ; 8080 et 8081 (sur 127.0.0.1) derrière nginx ou caddy ; le STUN toujours."""
    return [("tcp", p) for p in ((80, 443) if proxy == "traefik" else (8080, 8081))] + [("udp", 3478)]


def lancer(commande, delai=60, env=None, garder=SORTIE_MAX):
    r = executer(commande, capture_output=True, text=True, timeout=delai, cwd=DOSSIER if os.path.isdir(DOSSIER) else "/", env=env)
    return r.returncode, ((r.stdout or "") + (r.stderr or "")).strip()[-garder:]



def dossier_sur():
    """Le dossier du serveur, qui doit être un vrai dossier (jamais un lien posé là pour détourner un `rm`)."""
    if os.path.islink(DOSSIER):
        refuser("%s est un lien symbolique : refusé" % DOSSIER)
    return DOSSIER


def meta():
    try:
        with open(os.path.join(DOSSIER, MARQUE)) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def installe():
    return os.path.exists(os.path.join(DOSSIER, MARQUE))


def partiel():
    """Une installation commencée et pas finie : le script a échoué, ou n'a pas eu le temps. La marque dit « en_cours » ou « echec » (une marque sans état est celle d'avant : posée)."""
    return installe() and meta().get("etat", "ok") != "ok"


def marquer(donnees, etat):
    with open(os.path.join(DOSSIER, MARQUE), "w") as f:
        json.dump(dict(donnees, etat=etat), f)


def compose_cmd():
    """La commande Docker Compose de la machine : le greffon (`docker compose`) s'il est là, sinon l'ancien `docker-compose` ; None si aucun des deux."""
    if any(os.path.exists(p) for p in PLUGINS_COMPOSE):
        return ["docker", "compose"]
    return ["docker-compose"] if shutil.which("docker-compose") is not None else None


def compose(args, delai=60, garder=SORTIE_MAX):
    base = compose_cmd()
    if base is None:
        refuser("Docker Compose n'est pas installé sur cette machine")
    return lancer(base + ["-f", os.path.join(DOSSIER, "docker-compose.yml")] + args, delai, None, garder)


FILTRE_PILE = "label=com.docker.compose.project.working_dir="            # le dossier du serveur, posé par Compose sur chacun de ses conteneurs (v1 comme v2)


def conteneurs_docker():
    """Les conteneurs de la pile lus par `docker ps` : l'ancien docker-compose (1.x) n'a pas `ps --format json`."""
    code, sortie = lancer(["docker", "ps", "-a", "--filter", FILTRE_PILE + DOSSIER, "--format", "{{json .}}"], 30, None, SORTIE_LISTE)
    out = []
    for ligne in (sortie.splitlines() if code == 0 else []):
        try:
            x = json.loads(ligne)
        except ValueError:
            continue
        if isinstance(x, dict):
            m = re.search(r"com\.docker\.compose\.service=([^,]+)", str(x.get("Labels") or ""))
            ports = sorted({p.strip()[:60] for p in str(x.get("Ports") or "").split(",") if "->" in p})
            out.append({"service": (m.group(1) if m else str(x.get("Names") or ""))[:60], "etat": str(x.get("State") or "")[:20], "image": str(x.get("Image") or "")[:100], "ports": ports[:8]})
    return out


def conteneurs():
    if compose_cmd() is None:
        return []                                                  # sans Docker Compose, il n'y a rien à lister : l'état se rend quand même
    if compose_cmd() == ["docker-compose"]:
        return conteneurs_docker()
    code, sortie = compose(["ps", "-a", "--format", "json"], 30, SORTIE_LISTE)
    if code != 0:
        return []
    out = []
    for ligne in sortie.splitlines():
        try:
            c = json.loads(ligne)
        except ValueError:
            continue
        for x in (c if isinstance(c, list) else [c]):
            if isinstance(x, dict):
                pubs = [p for p in (x.get("Publishers") or []) if isinstance(p, dict) and int(p.get("PublishedPort") or 0) > 0]
                ports = sorted({"%s:%d->%d/%s" % (str(p.get("URL") or "0.0.0.0")[:40], int(p["PublishedPort"]), int(p.get("TargetPort") or 0), str(p.get("Protocol") or "tcp")[:4]) for p in pubs})
                out.append({"service": str(x.get("Service") or x.get("Name") or "")[:60], "etat": str(x.get("State") or "")[:20], "image": str(x.get("Image") or "")[:100], "ports": ports[:8]})
    return out


def verbe_etat(a):
    docker = shutil.which("docker") is not None
    d = {"ok": True, "docker": docker, "compose": compose_cmd() is not None, "jq": shutil.which("jq") is not None, "installe": installe(), "partiel": partiel(), "dossier": DOSSIER, "meta": meta(), "conteneurs": []}
    if docker and d["installe"]:
        d["conteneurs"] = conteneurs()
    if not d["installe"]:
        d["occupes"] = ["%s/%d" % (p, n) for p, n in PORTS_SURVEILLES if not port_libre(p, n)]       # ce qui bloquerait l'installation, avant de la tenter
    return d


def verbe_telecharger(a):
    if len(a) != 1:
        refuser("usage : telecharger <version>")
    v = verifier(a[0], VERSION, "version (v0.40.0 attendue : jamais « latest »)")
    if installe():
        refuser("un serveur est déjà posé dans %s : retire-le d'abord" % DOSSIER)
    dossier_sur()
    os.makedirs(DOSSIER, mode=0o700, exist_ok=True)
    with ouvrir(URL_SCRIPT % v, timeout=30) as r:
        corps = r.read(SCRIPT_MAX + 1)
    if not corps or len(corps) > SCRIPT_MAX:
        refuser("le script téléchargé est vide ou trop gros")
    chemin = os.path.join(DOSSIER, SCRIPT)
    with open(chemin, "wb") as f:
        f.write(corps)
    os.chmod(chemin, 0o600)
    return {"ok": True, "version": v, "sha256": hashlib.sha256(corps).hexdigest(), "taille": len(corps), "url": URL_SCRIPT % v}


def verbe_installer(a):
    if len(a) != 5:
        refuser("usage : installer <version> <sha256> <domaine> <email> <traefik|nginx|caddy>")
    v, sha = verifier(a[0], VERSION, "version"), verifier(a[1], SHA, "empreinte SHA-256")
    domaine, email = verifier(a[2].lower(), DOMAINE, "domaine"), verifier(a[3], EMAIL, "adresse e-mail")
    if a[4] not in PROXYS:
        refuser("proxy : traefik, nginx ou caddy")
    if domaine.endswith(RESERVES) or domaine in ("example.com", "example.org", "example.net"):
        refuser("un domaine d'exemple ne se joint pas : donne le vrai domaine qui pointe vers cette machine")
    if installe() or os.path.exists(os.path.join(DOSSIER, "config.yaml")):
        refuser("une installation inachevée est là (le script a échoué ou n'a pas fini) : retire-la avec ses données, puis recommence" if partiel() else "un serveur est déjà posé dans %s : il n'est jamais écrasé" % DOSSIER)
    dossier_sur()
    if shutil.which("docker") is None:
        refuser("Docker n'est pas installé sur cette machine")
    if shutil.which("jq") is None:
        refuser("jq n'est pas installé (le script officiel l'exige) : apt install jq")
    if compose_cmd() is None:
        refuser("Docker Compose n'est pas installé (le script officiel l'exige) : installe le greffon docker compose, ou docker-compose")
    chemin = os.path.join(DOSSIER, SCRIPT)
    try:
        fd = os.open(chemin, os.O_RDONLY | NOFOLLOW)
        with os.fdopen(fd, "rb") as f:
            corps = f.read(SCRIPT_MAX + 1)
    except OSError:
        refuser("le script n'est pas téléchargé : lance d'abord `telecharger %s`" % v)
    reel = hashlib.sha256(corps).hexdigest()
    if reel != sha:
        refuser("l'empreinte du script sur le disque (%s…) n'est pas celle que tu as confirmée : il n'est pas exécuté" % reel[:12])
    occupes = [(pr, p) for pr, p in ports_requis(a[4]) if not port_libre(pr, p)]
    if occupes:
        refuser("port déjà pris sur cette machine : %s. %s" % (", ".join("%d/%s" % (p, pr) for pr, p in occupes), "Un proxy existant (nginx) doit publier le serveur : choisis « nginx » ou « caddy »." if a[4] == "traefik" else "Libère-les : derrière nginx ou caddy, le serveur NetBird écoute sur 127.0.0.1:8080 et 8081."))
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "LANG": "C.UTF-8", "NETBIRD_DOMAIN": domaine, "NETBIRD_NON_INTERACTIVE": "true", "NETBIRD_REVERSE_PROXY_TYPE": PROXYS[a[4]],
           "NETBIRD_ENABLE_PROXY": "false", "NETBIRD_ENABLE_CROWDSEC": "false"}
    if a[4] == "traefik":
        env["NETBIRD_LETSENCRYPT_EMAIL"] = email
    donnees = {"version": v, "sha256": sha, "domaine": domaine, "email": email, "proxy": a[4], "installe_le": time.strftime("%Y-%m-%d %H:%M:%S")}
    # Ce qu'on lance est EXACTEMENT ce qu'on vient de hacher : une copie neuve, créée ici (O_EXCL, sans suivre de lien), pas le fichier que bash rouvrirait plus tard.
    copie = os.path.join(DOSSIER, ".installer-%d.sh" % os.getpid())
    fd = os.open(copie, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o700)
    with os.fdopen(fd, "wb") as f:
        f.write(corps)
    marquer(donnees, "en_cours")                                      # AVANT le script : s'il échoue ou dépasse le délai, la pile à moitié posée reste retirable
    try:
        code, sortie = lancer(["bash", copie], DELAI_INSTALL, env)
    except BaseException:
        marquer(donnees, "echec")
        raise
    finally:
        try:
            os.remove(copie)
        except OSError:
            pass
    marquer(donnees, "ok" if code == 0 else "echec")
    return {"ok": code == 0, "code": code, "sortie": sortie}



def verbe_mettre_a_jour(a):
    if len(a) > 1 or not installe():
        refuser("aucun serveur à mettre à jour" if not installe() else "usage : mettre_a_jour [version]")
    version = verifier(a[0], VERSION, "version") if a else ""
    dossier_sur()
    code, sortie = compose(["pull"], DELAI_TIRER)
    if code != 0:
        return {"ok": False, "code": code, "sortie": sortie}
    code, sortie = compose(["up", "-d"], DELAI_RELANCER)
    if code == 0 and version:
        marquer(dict(meta(), version=version), "ok")                          # la dernière publication est installée : NetBird les publie sous la même étiquette
    return {"ok": code == 0, "code": code, "sortie": sortie}


def verbe_commande(a):
    if len(a) != 1 or a[0] not in ACTIONS:
        refuser("commande : %s" % ", ".join(ACTIONS))
    if not installe():
        refuser("aucun serveur posé")
    dossier_sur()
    code, sortie = compose(ACTIONS[a[0]], 120)
    return {"ok": code == 0, "code": code, "sortie": sortie}


def verbe_nginx(a):
    chemin = os.path.join(DOSSIER, "nginx-netbird.conf")
    if not installe() or not os.path.isfile(chemin):
        refuser("pas de conf nginx : le proxy choisi à l'installation n'est pas nginx")
    with open(chemin, errors="replace") as f:
        return {"ok": True, "conf": f.read(20000)}


def verbe_retirer(a):
    if not installe() or len(a) > 1 or (a and a[0] != "purger"):
        refuser("aucun serveur posé" if not installe() else "usage : retirer [purger]")
    dossier_sur()
    purger = bool(a)
    if partiel() and not os.path.exists(os.path.join(DOSSIER, "docker-compose.yml")):
        code, sortie, purger = 0, "rien à arrêter : le script a échoué avant de poser la pile", True      # un reste sans pile : il n'y a rien à garder
    else:
        code, sortie = compose(["down"] + (["-v", "--remove-orphans"] if purger else []), 120)
    d = {"ok": code == 0, "code": code, "sortie": sortie, "purge": purger and code == 0}
    if code == 0 and purger:
        # Les volumes sont déjà détruits : on retire d'abord la marque (le serveur n'est plus « posé »), et un dossier qui résiste se dit au lieu de faire échouer le retrait.
        try:
            os.remove(os.path.join(DOSSIER, MARQUE))
            shutil.rmtree(DOSSIER)
        except OSError as e:
            d["avertissement"] = "les données sont supprimées, mais le dossier %s n'a pas pu être effacé (%s) : à retirer à la main avant de réinstaller" % (DOSSIER, str(e)[:100])
    return d



# ---- sauvegarde, restauration
def maintenant():
    return time.strftime("%Y%m%d-%H%M%S")


def inspecter(ids):
    """`docker inspect` de ces conteneurs : la liste de leurs fiches (une par conteneur)."""
    if not ids:
        return []
    code, sortie = lancer(["docker", "inspect"] + ids, 30, None, SORTIE_LISTE)
    try:
        d = json.loads(sortie) if code == 0 else []
    except ValueError:
        return []
    return [x for x in d if isinstance(x, dict)] if isinstance(d, list) else []


def fiches():
    """Les conteneurs de la pile : leurs volumes (nom et dossier sur la machine) et leurs images (référence et identifiant)."""
    if compose_cmd() == ["docker-compose"]:
        code, sortie = lancer(["docker", "ps", "-a", "-q", "--filter", FILTRE_PILE + DOSSIER], 30)
    else:
        code, sortie = compose(["ps", "-a", "-q"], 30)
    ids = [x for x in sortie.split() if re.match(r"^[0-9a-f]{6,64}$", x)] if code == 0 else []
    volumes, images, vus = [], [], set()
    for f in inspecter(ids):
        for m in f.get("Mounts") or []:
            if isinstance(m, dict) and m.get("Type") == "volume" and m.get("Name") and m.get("Source") and m["Name"] not in vus:
                vus.add(m["Name"])
                volumes.append({"nom": str(m["Name"]), "source": str(m["Source"])})
        ref, ident = str((f.get("Config") or {}).get("Image") or ""), str(f.get("Image") or "")
        images.append({"service": str(((f.get("Config") or {}).get("Labels") or {}).get("com.docker.compose.service") or f.get("Name") or "")[:60].lstrip("/"), "ref": ref, "id": ident})
    return volumes, images


def source_volume(nom, source):
    """Le dossier du volume sur la machine, vérifié : un chemin absolu qui finit par <nom>/_data (jamais un dossier choisi par quelqu'un d'autre)."""
    s = os.path.normpath(str(source))
    if not os.path.isabs(s) or os.path.basename(s) != "_data" or os.path.basename(os.path.dirname(s)) != nom:
        refuser("dossier de volume inattendu pour « %s »" % nom)
    return s


def archiver(source, archive, exclure=()):
    with tarfile.open(archive, "w:gz") as t:
        t.add(source, arcname=".", filter=lambda i: None if any(os.path.basename(i.name).startswith(x) for x in exclure) else i)


def extraire(archive, dest):
    """Extrait une archive DANS dest : aucun chemin absolu ni « .. », aucun lien qui sorte de dest, aucun fichier spécial."""
    racine = os.path.realpath(dest)
    with tarfile.open(archive, "r:gz") as t:
        membres = t.getmembers()
        for m in membres:
            cible = os.path.realpath(os.path.join(racine, m.name))
            if cible != racine and not cible.startswith(racine + os.sep):
                refuser("archive refusée : un chemin sort du dossier (%s)" % m.name[:60])
            if m.issym() or m.islnk():
                lien = os.path.realpath(os.path.join(os.path.dirname(cible), m.linkname)) if m.issym() else os.path.realpath(os.path.join(racine, m.linkname))
                if lien != racine and not lien.startswith(racine + os.sep):
                    refuser("archive refusée : un lien sort du dossier (%s)" % m.name[:60])
            elif not (m.isfile() or m.isdir()):
                refuser("archive refusée : fichier spécial (%s)" % m.name[:60])
        try:
            t.extractall(racine, members=membres, filter="fully_trusted")                  # les membres sont vérifiés ci-dessus
        except TypeError:
            t.extractall(racine, members=membres)


def vider(dossier):
    for nom in os.listdir(dossier):
        chemin = os.path.join(dossier, nom)
        if os.path.isdir(chemin) and not os.path.islink(chemin):
            shutil.rmtree(chemin)
        else:
            os.remove(chemin)


def fiche_sauvegarde(i):
    """Ce que dit meta.json d'une sauvegarde, ou None si elle est illisible."""
    try:
        with open(os.path.join(SAUVEGARDES, i, "meta.json")) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) and d.get("id") == i else None


def ids_sauvegardes():
    try:
        return sorted((x for x in os.listdir(SAUVEGARDES) if ID_SAUV.match(x)), reverse=True)
    except OSError:
        return []


def elaguer():
    for i in ids_sauvegardes()[GARDER:]:
        shutil.rmtree(os.path.join(SAUVEGARDES, i), ignore_errors=True)


def taille_dossier(d):
    return sum(os.path.getsize(os.path.join(d, f)) for f in os.listdir(d) if os.path.isfile(os.path.join(d, f)))


def en_marche():
    return any(c.get("etat") == "running" for c in conteneurs())


def verbe_sauvegarder(a):
    if len(a) > 1 or (a and a[0] not in RAISONS):
        refuser("usage : sauvegarder [%s]" % "|".join(RAISONS))
    if not installe():
        refuser("aucun serveur posé : rien à sauvegarder")
    dossier_sur()
    raison = a[0] if a else "manuelle"
    volumes, images = fiches()
    sources = [(v["nom"], source_volume(v["nom"], v["source"])) for v in volumes]
    ident = maintenant()
    while ident in ids_sauvegardes():                              # deux sauvegardes dans la même seconde
        ident = time.strftime("%Y%m%d-%H%M%S", time.localtime(time.time() + 1 + len(ids_sauvegardes())))
    dest = os.path.join(SAUVEGARDES, ident)
    os.makedirs(SAUVEGARDES, mode=0o700, exist_ok=True)
    os.makedirs(dest, mode=0o700)
    arrete = en_marche()
    try:
        if arrete:
            code, sortie = compose(["stop"], 90)                    # la base du serveur est copiée à l'arrêt : une copie cohérente
            if code != 0:
                refuser("le serveur n'a pas pu être arrêté pour la copie : %s" % sortie[-160:])
        fichiers = []
        for k, (nom, src) in enumerate(sources):
            f = "volume-%d.tar.gz" % k
            archiver(src, os.path.join(dest, f))
            fichiers.append({"nom": nom, "fichier": f})
        archiver(DOSSIER, os.path.join(dest, "dossier.tar.gz"), (".installer-",))
    except BaseException:
        shutil.rmtree(dest, ignore_errors=True)
        raise
    finally:
        if arrete:
            compose(["start"], 90)
    m = meta()
    fiche = {"id": ident, "quand": time.strftime("%Y-%m-%d %H:%M:%S"), "raison": raison, "version": m.get("version", ""), "domaine": m.get("domaine", ""), "proxy": m.get("proxy", ""), "volumes": fichiers, "images": images}
    with open(os.path.join(dest, "meta.json"), "w") as f:
        json.dump(dict(fiche, taille=taille_dossier(dest)), f)
    elaguer()
    return {"ok": True, "id": ident, "raison": raison, "volumes": len(fichiers), "taille": taille_dossier(dest)}


def verbe_sauvegardes(a):
    if a:
        refuser("sauvegardes n'a pas d'argument")
    liste = []
    for i in ids_sauvegardes():
        f = fiche_sauvegarde(i)
        if f:
            liste.append({"id": i, "quand": str(f.get("quand") or ""), "raison": str(f.get("raison") or ""), "version": str(f.get("version") or ""), "taille": int(f.get("taille") or 0), "volumes": len(f.get("volumes") or [])})
    return {"ok": True, "sauvegardes": liste, "dossier": SAUVEGARDES, "garde": GARDER}


def remettre_images(fiche):
    """`docker tag <identifiant d'alors> <référence>` : la référence repointe vers l'ancienne image, si elle est encore sur la machine."""
    remises = 0
    for x in fiche.get("images") or []:
        if isinstance(x, dict) and ID_IMAGE.match(str(x.get("id") or "")) and REF_IMAGE.match(str(x.get("ref") or "")):
            code, _ = lancer(["docker", "tag", x["id"], x["ref"]], 30)
            remises += 1 if code == 0 else 0
    return remises


def verbe_restaurer(a):
    if not a or len(a) > 2 or (len(a) == 2 and a[1] != "images"):
        refuser("usage : restaurer <id> [images]")
    ident = verifier(a[0], ID_SAUV, "identifiant de sauvegarde")
    f = fiche_sauvegarde(ident)
    if f is None:
        refuser("sauvegarde introuvable ou illisible : %s" % ident)
    dossier_sur()
    src = os.path.join(SAUVEGARDES, ident)
    cibles = []
    for v in f.get("volumes") or []:
        if not isinstance(v, dict) or not re.match(r"^volume-\d{1,3}\.tar\.gz$", str(v.get("fichier") or "")) or not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$", str(v.get("nom") or "")):
            refuser("la sauvegarde décrit un volume illisible")
        cibles.append((v["nom"], os.path.join(src, v["fichier"])))
    if not os.path.isfile(os.path.join(src, "dossier.tar.gz")):
        refuser("la sauvegarde est incomplète : dossier.tar.gz manque")
    securite = ""
    if installe() and os.path.exists(os.path.join(DOSSIER, "docker-compose.yml")):
        securite = verbe_sauvegarder(["avant_restauration"])["id"]   # on ne remplace rien sans avoir copié ce qui est là
        code, sortie = compose(["down"], 120)
        if code != 0:
            refuser("le serveur n'a pas pu être arrêté : %s" % sortie[-160:])
    os.makedirs(DOSSIER, mode=0o700, exist_ok=True)
    extraire(os.path.join(src, "dossier.tar.gz"), DOSSIER)
    for nom, archive in cibles:
        lancer(["docker", "volume", "create", nom], 30)
        code, sortie = lancer(["docker", "volume", "inspect", "-f", "{{.Mountpoint}}", nom], 20)
        point = source_volume(nom, sortie.strip()) if code == 0 else refuser("le volume « %s » n'a pas pu être préparé" % nom)
        vider(point)
        extraire(archive, point)
    if not installe():
        marquer({"version": f.get("version", ""), "domaine": f.get("domaine", ""), "proxy": f.get("proxy", ""), "installe_le": time.strftime("%Y-%m-%d %H:%M:%S")}, "ok")
    remises = remettre_images(f) if len(a) == 2 else 0
    code, sortie = compose(["up", "-d"] + (["--force-recreate"] if len(a) == 2 else []), 150)
    return {"ok": code == 0, "code": code, "sortie": sortie, "id": ident, "securite": securite, "volumes": len(cibles), "images_remises": remises}


# ---- pare-feu
def pare_feu_outil():
    return "ufw" if shutil.which("ufw") else "firewalld" if shutil.which("firewall-cmd") else ""


def pare_feu_lire(outil):
    """(actif, ports ouverts parmi ceux de NetBird)."""
    if outil == "ufw":
        code, sortie = lancer(["ufw", "status"], 20)
        actif = code == 0 and re.search(r"^Status:\s+active", sortie, re.M) is not None
        ouverts = set()
        for ligne in sortie.splitlines():
            m = re.match(r"^(\d{1,5})(?:/(tcp|udp))?(?:\s+\(v6\))?\s+ALLOW\b", ligne.strip())
            if m:
                ouverts |= {"%s/%s" % (m.group(1), p) for p in ((m.group(2),) if m.group(2) else ("tcp", "udp"))}
        return actif, sorted(ouverts & set(PORTS_NETBIRD))
    code, sortie = lancer(["firewall-cmd", "--state"], 20)
    actif = code == 0 and sortie.strip() == "running"
    code, ports = lancer(["firewall-cmd", "--list-ports"], 20)
    return actif, sorted(set(ports.split()) & set(PORTS_NETBIRD)) if code == 0 else []


def verbe_pare_feu(a):
    if a:
        refuser("pare_feu n'a pas d'argument")
    outil = pare_feu_outil()
    if not outil:
        return {"ok": True, "outil": "", "actif": False, "ouverts": []}
    actif, ouverts = pare_feu_lire(outil)
    return {"ok": True, "outil": outil, "actif": actif, "ouverts": ouverts}


def ports_publics(proxy):
    """Ce qu'il faut ouvrir sur internet : 443 (le proxy) et 3478/udp ; 80 aussi avec traefik (certificats)."""
    return (["80/tcp"] if proxy == "traefik" else []) + ["443/tcp", "3478/udp"]


def pare_feu_agir(outil, port, ouvrir):
    if outil == "ufw":
        return lancer(["ufw", "allow", port, "comment", COMMENTAIRE_PF] if ouvrir else ["ufw", "delete", "allow", port], 30)
    code, sortie = lancer(["firewall-cmd", "--permanent", "--add-port=" + port if ouvrir else "--remove-port=" + port], 30)
    return (lancer(["firewall-cmd", "--reload"], 30) if code == 0 else (code, sortie))


def verbe_pare_feu_ouvrir(a):
    if len(a) != 1 or a[0] not in PROXYS:
        refuser("usage : pare_feu_ouvrir <traefik|nginx|caddy>")
    outil = pare_feu_outil()
    if not outil:
        refuser("aucun pare-feu connu sur cette machine (ufw, firewalld) : rien à ouvrir")
    actif, ouverts = pare_feu_lire(outil)
    if not actif:
        refuser("le pare-feu %s est inactif : les ports ne sont pas filtrés, rien à ouvrir" % outil)
    par_nous, deja = [], []
    for p in ports_publics(a[0]):
        if p in ouverts:
            deja.append(p)
            continue
        code, sortie = pare_feu_agir(outil, p, True)
        if code != 0:
            return {"ok": False, "code": code, "sortie": sortie, "ouverts_par_nous": par_nous, "erreur": "%s : ouverture de %s refusée (%s)" % (outil, p, sortie[-120:])}
        par_nous.append(p)
    return {"ok": True, "outil": outil, "ouverts_par_nous": par_nous, "deja_ouverts": deja}


def verbe_pare_feu_fermer(a):
    if not a or any(p not in PORTS_NETBIRD for p in a):
        refuser("pare_feu_fermer : seulement %s" % ", ".join(PORTS_NETBIRD))
    outil = pare_feu_outil()
    if not outil:
        refuser("aucun pare-feu connu sur cette machine")
    fermes = []
    for p in a:
        code, sortie = pare_feu_agir(outil, p, False)
        if code != 0:
            return {"ok": False, "code": code, "sortie": sortie, "fermes": fermes}
        fermes.append(p)
    return {"ok": True, "outil": outil, "fermes": fermes}


def verbe_installer_compose(a):
    if a:
        refuser("installer_compose n'a pas d'argument")
    if shutil.which("docker") is None:
        refuser("Docker n'est pas installé : Cassandra n'installe pas Docker, installe-le d'abord")
    if compose_cmd() is not None:
        refuser("Docker Compose est déjà installé")
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "DEBIAN_FRONTEND": "noninteractive"}
    if shutil.which("apt-get") is not None:
        for paquet in ("docker-compose-plugin", "docker-compose-v2", "docker-compose"):
            code, sortie = lancer(["apt-cache", "policy", paquet], 30, env)
            if code == 0 and "Candidate:" in sortie and "Candidate: (none)" not in sortie:
                break
        else:
            refuser("la distribution n'offre aucun paquet Docker Compose (docker-compose-plugin, docker-compose-v2, docker-compose) : installe-le à la main")
        commandes = [["apt-get", "update"], ["apt-get", "install", "-y", paquet]]
    elif shutil.which("dnf") is not None or shutil.which("yum") is not None:
        commandes = [["dnf" if shutil.which("dnf") is not None else "yum", "install", "-y", "docker-compose-plugin"]]
    else:
        refuser("aucun gestionnaire de paquets connu (apt-get, dnf, yum) : installe Docker Compose à la main")
    sortie = ""
    for c in commandes:
        code, sortie = lancer(c, 90 if "update" in c else 200, env)
        if code != 0:
            return {"ok": False, "code": code, "sortie": sortie}
    if compose_cmd() is None:
        return {"ok": False, "code": 1, "sortie": sortie, "erreur": "le paquet est installé mais Docker Compose reste introuvable (ni docker compose, ni docker-compose)"}
    return {"ok": True, "code": 0, "sortie": sortie, "commande": " ".join(compose_cmd())}


