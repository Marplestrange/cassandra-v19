def ip_sortante():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))                                  # rien n'est envoyé : on lit seulement l'adresse que le système choisirait
        return s.getsockname()[0]
    finally:
        s.close()


def verbe_ip(a):
    if a:
        refuser("ip n'a pas d'argument")
    ip = ip_sortante()
    return {"ok": True, "ip": ip, "privee": ipaddress.ip_address(ip).is_private}



VERBES = {"etat": verbe_etat, "telecharger": verbe_telecharger, "installer": verbe_installer, "mettre_a_jour": verbe_mettre_a_jour, "commande": verbe_commande, "nginx": verbe_nginx, "retirer": verbe_retirer, "sauvegarder": verbe_sauvegarder, "sauvegardes": verbe_sauvegardes, "restaurer": verbe_restaurer,
          "pare_feu": verbe_pare_feu, "pare_feu_ouvrir": verbe_pare_feu_ouvrir, "pare_feu_fermer": verbe_pare_feu_fermer, "ip": verbe_ip, "installer_jq": verbe_installer_jq, "installer_compose": verbe_installer_compose}


def serveur(argv):
    """Le verbe demandé, ou {"ok": False, "erreur": …}. Aucune exception ne sort d'ici."""
    try:
        if not argv or argv[0] not in VERBES:
            refuser("verbe : %s" % ", ".join(VERBES))
        return VERBES[argv[0]](list(argv[1:]))
    except ValueError as e:
        return {"ok": False, "erreur": str(e)}
    except subprocess.TimeoutExpired:
        return {"ok": False, "erreur": "délai dépassé"}
    except OSError as e:
        return {"ok": False, "erreur": "%s : %s" % (type(e).__name__, str(e)[:120])}


def main():
    d = serveur(sys.argv[1:])
    print(json.dumps(d, ensure_ascii=False))
    sys.exit(0 if d.get("ok") else 1)


if __name__ == "__main__":
    main()
