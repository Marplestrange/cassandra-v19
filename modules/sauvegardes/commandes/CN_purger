#!/usr/bin/env python3
"""Ne garde que les N dossiers datés les plus récents. Usage : purger BASE GARDER."""
import json
import re
import subprocess
import sys


def main():
    if len(sys.argv) < 3:
        sys.exit(2)
    base = sys.argv[1].rstrip("/")
    try:
        garder = int(sys.argv[2])
    except ValueError:
        sys.exit(2)
    r = subprocess.run(["rclone", "lsjson", "--dirs-only", "--max-depth", "1", base],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        print(r.stderr or "lister a échoué")
        sys.exit(r.returncode)
    try:
        dossiers = sorted(x.get("Path") or x.get("Name") for x in json.loads(r.stdout or "[]") if (x.get("Path") or x.get("Name")))
    except ValueError:
        print("réponse rclone illisible")
        sys.exit(3)
    dossiers = [d for d in dossiers if re.match(r"^\d{4}-\d{2}-\d{2}$", str(d))]       # jamais un autre dossier que les copies datées
    if garder < 1:
        print("garder doit valoir au moins 1")
        sys.exit(2)
    purges = max(0, len(dossiers) - garder)
    for d in dossiers[:-garder]:
        subprocess.run(["rclone", "purge", base + "/" + d], capture_output=True, text=True, timeout=300)
    print("purge %d dossier(s)" % purges)


if __name__ == "__main__":
    main()
