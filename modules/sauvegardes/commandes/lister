#!/usr/bin/env python3
"""Les dossiers d'une destination rclone. Usage : lister DEST."""
import json
import subprocess
import sys


def main():
    if len(sys.argv) < 2:
        sys.exit(2)
    r = subprocess.run(["rclone", "lsjson", "--dirs-only", "--max-depth", "1", sys.argv[1]],
                       capture_output=True, text=True, timeout=120)
    print((r.stdout or "") + (r.stderr or ""))
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
