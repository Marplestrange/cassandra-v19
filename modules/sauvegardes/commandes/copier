#!/usr/bin/env python3
"""rclone copy d'une source vers une destination datée. Usage : copier SOURCE DEST [blanc=1]."""
import subprocess
import sys


def main():
    if len(sys.argv) < 3:
        sys.exit(2)
    source, dest = sys.argv[1], sys.argv[2]
    blanc = len(sys.argv) > 3 and sys.argv[3] == "1"
    args = ["rclone", "copy", source, dest, "--stats-one-line", "--stats", "5s"]
    if blanc:
        args.append("--dry-run")
    r = subprocess.run(args, capture_output=True, text=True, timeout=1800)
    print((r.stdout or "") + (r.stderr or ""))
    sys.exit(r.returncode)


if __name__ == "__main__":
    main()
