[Unit]
Description=Sensorium de Cassandra (le collecteur)
After=network-online.target
Wants=network-online.target

[Service]
# Le collecteur voit tout le système : il tourne en root, mais ne peut écrire que dans son dossier et son socket.
Type=simple
User=root
WorkingDirectory=@DONNEES@/sensorium
Environment=PYTHONUNBUFFERED=1
Environment=SENSORIUM_DB=@DONNEES@/sensorium/sensorium.db
Environment=SENSORIUM_SOCKET=/run/sensorium/knowledge.sock
Environment=CASSANDRA_DATA_DIR=@DONNEES@/sensorium
Environment=SENSORIUM_CONFIG_JSON=@CONFIG@/config.json
Environment=SENSORIUM_FASTPANEL_CREDS=@CONFIG@/fastpanel_creds.txt
Environment=SENSORIUM_DNS_LOCAL_CONF=@CONFIG@/dns-local.conf
Environment=SENSORIUM_DNS_LOCAL_NOMS=@DONNEES@/sensorium/dns-local/noms.hosts
ExecStart=/usr/bin/python3 @RACINE@/current/modules/sensorium/CN_sensorium.py
# Le collecteur ferme son socket à root seul ; le noyau (qui ne l'est pas) y accède par groupe, et par ce socket seulement.
ExecStartPost=/bin/sh @RACINE@/current/modules/sensorium/CN_ouvrir-socket.sh /run/sensorium @UTILISATEUR@
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
RuntimeDirectory=sensorium
RuntimeDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@DONNEES@/sensorium /run/sensorium
UMask=0077

[Install]
WantedBy=multi-user.target
